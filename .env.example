# OpenCode Telegram Controller - example environment file.
# Copy to .env (project root) or to ~/.config/opencode-telegram-controller/.env
# (for the systemd service). Never commit real secrets.

# --- Telegram ---
# Bot token from @BotFather. Required.
OTC_TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to use the bot. Required.
# Get your ID with @userinfobot or @getidsbot.
OTC_ALLOWED_USER_IDS=

# Override the Telegram API base URL. Usually not needed.
# OTC_TELEGRAM_API_BASE=https://api.telegram.org

# Optional: comma-separated DNS servers used ONLY to resolve api.telegram.org.
# Useful when the local DNS provider (e.g. NextDNS) blocks api.telegram.org
# by resolving it to 0.0.0.0. Example: OTC_TELEGRAM_NAMESERVERS=1.1.1.1,9.9.9.9
# Requires the optional extra: uv sync --extra dns
# OTC_TELEGRAM_NAMESERVERS=

# --- OpenCode ---
# Path or name of the opencode binary. Default: "opencode" (resolved via PATH).
# OTC_OPENCODE_BIN=opencode
# Optional model override, e.g. opencode/big-pickle or deepseek/deepseek-chat.
# OTC_OPENCODE_MODEL=
# Agent used for tasks. Default: build
# OTC_OPENCODE_AGENT=build

# --- Tasks ---
# Maximum number of tasks running at the same time. Default: 1.
# OTC_MAX_CONCURRENT_TASKS=1
# Per-task timeout in seconds. Default: 3600 (1 hour).
# OTC_DEFAULT_TIMEOUT_SECONDS=3600
# Minimum seconds between progress notifications. Default: 300 (5 min).
# OTC_PROGRESS_INTERVAL_SECONDS=300

# --- Projects ---
# Path to the projects allowlist YAML file.
# OTC_PROJECTS_FILE=/home/andres/Proyects/opencode-telegram-controller/config/projects.yaml
# Default project name selected on /start for new users.
# OTC_DEFAULT_PROJECT=

# --- Summaries ---
# Engine used for task summaries: "deterministic" (default) or "ollama".
# OTC_SUMMARY_ENGINE=deterministic
# OTC_OLLAMA_URL=http://localhost:11434
# OTC_OLLAMA_MODEL=llama3.2

# --- Storage ---
# SQLite database path.
# OTC_DATABASE_PATH=/home/andres/.local/share/opencode-telegram-controller/tasks.db

# --- Logging ---
# OTC_LOG_LEVEL=INFO
# OTC_LOG_FILE=/home/andres/.local/share/opencode-telegram-controller/controller.log
