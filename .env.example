# OpenCode Telegram Controller - example environment file.
# Copy to .env (project root) or to ~/.config/opencode-telegram-controller/.env
# (for the systemd service). Never commit real secrets.

# --- Telegram ---
# Bot token from @BotFather. Required.
OTC_TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to use the bot. Required.
# Get your ID with @userinfobot or @getidsbot.
OTC_ALLOWED_USER_IDS=

# Override the Telegram API base URL. Usually not needed.
# OTC_TELEGRAM_API_BASE=https://api.telegram.org

# Optional: comma-separated DNS servers used ONLY to resolve api.telegram.org.
# Useful when the local DNS provider (e.g. NextDNS) blocks api.telegram.org
# by resolving it to 0.0.0.0. Example: OTC_TELEGRAM_NAMESERVERS=1.1.1.1,9.9.9.9
# Requires the optional extra: uv sync --extra dns
# OTC_TELEGRAM_NAMESERVERS=

# --- OpenCode ---
# Path or name of the opencode binary. Default: "opencode" (resolved via PATH).
# OTC_OPENCODE_BIN=opencode
# Optional model override, e.g. opencode/big-pickle or deepseek/deepseek-chat.
# OTC_OPENCODE_MODEL=
# Agent used for tasks. Default: build
# OTC_OPENCODE_AGENT=build

# --- Tasks ---
# Maximum number of tasks running at the same time. Default: 1.
# OTC_MAX_CONCURRENT_TASKS=1
# Per-task timeout in seconds. Default: 3600 (1 hour).
# OTC_DEFAULT_TIMEOUT_SECONDS=3600
# Minimum seconds between progress notifications. Default: 300 (5 min).
# OTC_PROGRESS_INTERVAL_SECONDS=300

# --- Projects ---
# Path to the projects allowlist YAML file.
# OTC_PROJECTS_FILE=/home/andres/Proyects/opencode-telegram-controller/config/projects.yaml
# Default project name selected on /start for new users.
# OTC_DEFAULT_PROJECT=

# --- Summaries ---
# Engine used for task summaries: "deterministic" (default) or "ollama".
# OTC_SUMMARY_ENGINE=deterministic
# OTC_OLLAMA_URL=http://localhost:11434
# OTC_OLLAMA_MODEL=llama3.2

# --- Storage ---
# SQLite database path.
# OTC_DATABASE_PATH=/home/andres/.local/share/opencode-telegram-controller/tasks.db

# --- Logging ---
# OTC_LOG_LEVEL=INFO
# OTC_LOG_FILE=/home/andres/.local/share/opencode-telegram-controller/controller.log

# --- PC Control: System / Network ---
# Timeouts (seconds) for subprocess calls made by the PC managers.
# OTC_TIMEOUT_QUICK_SECONDS=10
# OTC_TIMEOUT_DOCKER_SECONDS=10
# OTC_TIMEOUT_VPN_SECONDS=60

# --- PC Control: Permissions ---
# Comma-separated Telegram user IDs that may only READ (no /vpn, /docker_*,
# /lock, /reboot, ...). Default: none (every allowlisted user is admin).
# OTC_READ_ONLY_USER_IDS=

# --- PC Control: VPN (NordVPN) ---
# Provider: none | auto | nordvpn. "none" disables the /vpn commands.
# OTC_VPN_PROVIDER=auto
# Country allowlist for "/vpn <country>" (lowercase). Empty = no countries.
# OTC_VPN_COUNTRIES=
# Fixed dedicated server for /vpn_dedicated.
# OTC_VPN_DEDICATED_SERVER=

# --- PC Control: Docker ---
# Container allowlist for /docker_restart and /docker_logs. Empty = any name
# that currently exists on the daemon (validated, never shell-expanded).
# OTC_DOCKER_ALLOWED_CONTAINERS=
# Default --tail lines for /docker_logs.
# OTC_DOCKER_LOGS_LINES=200

# --- PC Control: Desktop ---
# Allow /screenshot (grim) capture.
# OTC_SCREENSHOT_ENABLED=true

# --- PC Control: Media ---
# Camera device used by /photo (ffmpeg v4l2 input).
# OTC_CAMERA_DEVICE=/dev/video0
# Capture resolution for /photo (wxh).
# OTC_CAMERA_RESOLUTION=1280x720
# Audio source for /record_mic (PulseAudio name or "default").
# OTC_MIC_SOURCE=default
# Default recording length (seconds) for /record_mic with no argument.
# OTC_MIC_DEFAULT_SECONDS=10
# Hard maximum for /record_mic <seconds>.
# OTC_MIC_MAX_SECONDS=120
# Maximum size (MB) of audio/video files downloaded from Telegram to play.
# OTC_MEDIA_MAX_DOWNLOAD_MB=20
# Kill mpv playback after this many seconds even if it did not finish.
# OTC_PLAYBACK_MAX_SECONDS=3600
# Live stream (/stream): length of each wf-recorder video clip in seconds.
# OTC_STREAM_CLIP_SECONDS=5
# Live stream: frames per second captured by wf-recorder.
# OTC_STREAM_FRAMERATE=15
# Live stream: include microphone audio in each clip (wf-recorder -a).
# OTC_STREAM_WITH_AUDIO=true

# --- PC Control: Power ---
# Seconds a /reboot /shutdown /sleep confirmation stays valid.
# OTC_POWER_CONFIRMATION_TIMEOUT_SECONDS=60
# Optional fixed argv overrides; otherwise loginctl reboot/poweroff/suspend is used.
# OTC_POWER_REBOOT_COMMAND=
# OTC_POWER_SHUTDOWN_COMMAND=
# OTC_POWER_SLEEP_COMMAND=

# --- PC Control: Health monitoring ---
# Proactive alert interval in seconds; 0 disables the background loop.
# OTC_HEALTH_CHECK_INTERVAL_SECONDS=0
